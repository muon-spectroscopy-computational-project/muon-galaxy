<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE visualization SYSTEM "../../visualization.dtd">
<visualization name="crystvis-js" embeddable="false">
    <description>A Three.js based crystallographic visualisation tool</description>
    <data_sources>
        <data_source>
            <model_class>HistoryDatasetAssociation</model_class>
            <test type="isinstance" test_attr="datatype" result_type="datatype">molecules.Cell</test>
            <test type="isinstance" test_attr="datatype" result_type="datatype">molecules.CIF</test>
            <test type="isinstance" test_attr="datatype" result_type="datatype">molecules.XYZ</test>
            <test type="isinstance" test_attr="datatype" result_type="datatype">molecules.PDB</test>
            <to_param param_attr="id">dataset_id</to_param>
        </data_source>
    </data_sources>
    <params>
        <param type="dataset" var_name_in_template="hda" required="true">dataset_id</param>
    </params>
    <entry_point entry_point_type="chart" src="crystvis.js"/>
    <settings>
        <input>
            <label>Atom Labels</label>
            <name>atom_labels</name>
            <help>Display the atomic symbol of each atom</help>
            <type>select</type>
            <display>radio</display>
            <value>off</value>
            <data>
                <data>
                    <label>On</label>
                    <value>on</value>
                </data>
                <data>
                    <label>Off</label>
                    <value>off</value>
                </data>
            </data>
        </input>
    </settings>
</visualization>